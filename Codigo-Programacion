## Switch it Up!:

def switch_it_up(number):
    numbers = {
        0: "Zero" ,
        1: "One" ,
        2: "Two" ,
        3: "Three" ,
        4: "Four" ,
        5: "Five" ,
        6: "Six" ,
        7: "Seven" ,
        8: "Eight" ,
        9: "Nine" 
                }
     return numbers[number]

## Regexp Basics - is it a digit?

def is_digit(string):
   return len(string) == 1 and string.isdigit()



